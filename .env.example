# 복사해서 .env.local 로 저장 후 값을 채우세요. (.env* 파일은 git에 올리지 않습니다)
# 값이 비어 있으면 로그인·저장 없이 "체험 모드"로만 동작합니다.

# ── Supabase (프로젝트 Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude API (console.anthropic.com → API Keys) ── 서버 전용
ANTHROPIC_API_KEY=
CLAUDE_MODEL_TUTOR=claude-haiku-5-5
CLAUDE_MODEL_GRADER=claude-sonnet-5-5
# 로그인 없는 체험 모드에서도 Claude 튜터를 쓸지 (기본: 규칙 기반 튜터만)
DEMO_TUTOR_ENABLED=false

# ── 계정 ──
# 교사 가입을 허용할 이메일 도메인(쉼표로 구분). 비어 있으면 교사 가입 불가.
TEACHER_EMAIL_DOMAIN_ALLOWLIST=
# 학생 내부 로그인 ID에 쓰는 도메인(실제로 메일을 받지 않는 주소)
STUDENT_EMAIL_DOMAIN=students.matter-lab.invalid
# PIN 해시에 섞는 비밀 값(긴 무작위 문자열). 배포 후 바꾸면 모든 학생 PIN을 재발급해야 합니다.
STUDENT_PIN_PEPPER=

# ── 실험 ──
# true: 교과서 값(로르산 44 ℃, 팔미트산 63 ℃) / false: NIST 참조값(43.9 / 61.9 ℃)
TEXTBOOK_MODE=true
APP_ENV=local

# 로컬 DB 테스트(npm run test:db) 전용
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/labtest
